# Copy to .env and fill in. Never commit .env.
# Nothing here is required to preview the interface; these are the names the
# application will use as the phases in docs/planning/BUILD_PLAN.md land.

# Phase 0 — database
DATABASE_URL=

# Phase 1 — sessions
SESSION_SECRET=

# Phase 2 — maps (server side only, never exposed to the browser)
MAP_PROVIDER_KEY=

# Phase 3 — payments
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=

# Phase 7 — push notifications
FCM_SERVER_KEY=
