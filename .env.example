# Copy to .env and fill in. Never commit .env.
# This is the single documented answer to "what configuration does this need".
# Every variable read by apps/api/src/config/env.ts MUST be listed here —
# scripts/check-env-example.sh fails if the two drift. Values below are safe
# dummies, never real credentials.

# ── runtime (read by apps/api/src/config/env.ts) ─────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── required in every non-test environment ────────────────────────────────
# PostgreSQL connection. Railway managed Postgres in prod, local compose in dev.
# PostgreSQL is the ONLY stateful dependency (DEC-186): realtime = LISTEN/NOTIFY,
# queues = SKIP LOCKED, sessions/read models = tables.
DATABASE_URL=postgres://user:password@localhost:5432/rideshare
# Signing secret for access/refresh tokens. At least 32 random characters.
JWT_SECRET=replace-with-32-plus-random-characters

# ── identity / bootstrap admin ────────────────────────────────────────────
# The system ships with ONE admin account (DEC): set both or neither. The admin
# signs in with email + password, changes the password, and creates other staff.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── security / hardening ──────────────────────────────────────────────────
# Comma-separated CORS allowlist. Empty = allow all (development only; set an
# explicit allowlist in production).
CORS_ORIGINS=
# Rate limit: requests per window (milliseconds) — defaults 100 / 60s.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── email (login codes + verification + password reset) ──────────────────
# Generic SMTP. Works with Resend (host smtp.resend.com, port 465, secure
# true, user "resend", pass = Resend API key), Gmail SMTP, Zoho, or any relay.
# When SMTP_HOST is unset, development logs the code server-side and
# production REFUSES to send (honest sandbox — never a fake success).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'auto' (default) = implicit TLS on 465/2465, STARTTLS elsewhere. Override
# with 'true'/'false' only for a non-standard relay.
SMTP_SECURE=auto
EMAIL_FROM=

# ── email sign-up policy ──────────────────────────────────────────────────
# Comma-separated EXTRA allowed email domains (exact or wildcard-by-suffix).
# The built-in allowlist (popular providers + all .edu / .edu.<cc>) always
# applies; add company/private domains here, e.g. "mycompany.eg,corp.com".
EMAIL_ALLOWED_DOMAINS=

# ── migrations on boot ────────────────────────────────────────────────────
# 'true' (default) runs migrations before the app starts (single-instance
# Railway path). Set 'false' to migrate out-of-band.
AUTO_MIGRATE=true
MIGRATIONS_DIR=

# Phase 2 — commercial map provider (server side only, never exposed to the browser)
MAP_PROVIDER_KEY=

# Phase 3 — Paymob card/wallet gateway (mode is sandbox until keys are set)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Phase 7 — push notifications
FCM_SERVER_KEY=
