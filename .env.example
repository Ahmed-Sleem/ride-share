# Copy to .env and fill in. Never commit .env.
# This is the single documented answer to "what configuration does this need".
# Every variable read by apps/api/src/config/env.ts MUST be listed here —
# scripts/check-env-example.sh fails if the two drift. Values below are safe
# dummies, never real credentials.

# ── runtime (read by apps/api/src/config/env.ts) ─────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── required in every non-test environment ────────────────────────────────
# PostgreSQL connection. Railway managed Postgres in prod, local compose in dev.
# PostgreSQL is the ONLY stateful dependency (DEC-186): realtime = LISTEN/NOTIFY,
# queues = SKIP LOCKED, sessions/read models = tables.
DATABASE_URL=postgres://user:password@localhost:5432/rideshare
# Signing secret for access/refresh tokens. At least 32 random characters.
JWT_SECRET=replace-with-32-plus-random-characters

# ── identity / bootstrap admin ────────────────────────────────────────────
# The system ships with ONE admin account (DEC): set both or neither. The admin
# signs in with email + password, changes the password, and creates other staff.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── dev / testing bypass ──────────────────────────────────────────────────
# 'true' disables email-OTP verification (sign-up/sign-in proceed without a
# code; the allowlist and one-email-one-account rules still apply). For testing
# before an email provider is wired. Keep 'false' in production.
AUTH_OTP_BYPASS=false

# ── security / hardening ──────────────────────────────────────────────────
# Comma-separated CORS allowlist. Empty = allow all (development only; set an
# explicit allowlist in production).
CORS_ORIGINS=
# Rate limit: requests per window (milliseconds) — defaults 100 / 60s.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── email (login codes + verification + password reset) ──────────────────
# Generic SMTP. Works with Resend (host smtp.resend.com, port 465, secure
# true, user "resend", pass = Resend API key), Gmail SMTP, Zoho, or any relay.
# When SMTP_HOST is unset, development logs the code server-side and
# production REFUSES to send (honest sandbox — never a fake success).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'auto' (default) = implicit TLS on 465/2465, STARTTLS elsewhere. Override
# with 'true'/'false' only for a non-standard relay.
SMTP_SECURE=auto
EMAIL_FROM=

# ── geography (M2, numeric lat/lng) ─────────────────────────────────────
# Minimum spacing between stops in metres (a closer stop needs an override +
# reason), and the maximum walking gap between consecutive corridor stops.
STOP_MIN_SPACING_M=100
STOP_MAX_GAP_M=1000
# Field capture: a GPS fix worse than this (metres) is refused; the local
# photo directory (mount a volume here in production) and max photo bytes.
STOP_MAX_FIX_ACCURACY_M=20
PHOTO_STORAGE_DIR=./data/photos
PHOTO_MAX_BYTES=8000000
# Routes (M3): average vehicle speed used to estimate run-time to each stop.
ROUTE_SPEED_KMH=20
# Journeys (M3): default seats on a claimed vehicle; claim-release lock window.
VEHICLE_SEATS=14
MIN_CLAIM_LEAD_MINUTES=30
# Boarding window (P3.8). Manual code entry has no lockout.
BOARDING_WINDOW_BEFORE_MIN=15
BOARDING_WINDOW_AFTER_MIN=30
# Minutes behind timetable before a pickup is refused (P3.9).
MAX_SCHEDULE_SLIP_MIN=10

# ── email sign-up policy ──────────────────────────────────────────────────
# Comma-separated EXTRA allowed email domains (exact or wildcard-by-suffix).
# The built-in allowlist (popular providers + all .edu / .edu.<cc>) always
# applies; add company/private domains here, e.g. "mycompany.eg,corp.com".
EMAIL_ALLOWED_DOMAINS=

# ── migrations on boot ────────────────────────────────────────────────────
# 'true' (default) runs migrations before the app starts (single-instance
# Railway path). Set 'false' to migrate out-of-band.
AUTO_MIGRATE=true
MIGRATIONS_DIR=

# ── web server (apps/web/server.js) ─────────────────────────────────────
# The web server proxies /v1/* to the API over the private network (no CORS,
# no key in the client) and serves the map config. In production this is the
# API service's Railway private host.
API_INTERNAL_URL=
# Map provider: 'osm' (default — OpenStreetMap, free, no key, DEC-198) or
# 'google'. Only when 'google': a client-safe key (restrict it by referrer).
MAP_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# Phase 3 — Paymob card/wallet gateway (mode is sandbox until keys are set)
# Paymob (P3.7) — master flag first (DEC-204): false hides the option app-wide.
PAYMOB_ENABLED=false
PAYMOB_MODE=sandbox
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_WALLET_INTEGRATION_ID=
# Platform commission on fares, integer percent 0..90 (0 = none until set).
COMMISSION_PERCENT=0

# Phase 7 — push notifications
FCM_SERVER_KEY=
