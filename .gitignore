# secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
**/google-services.json
**/play-service-account*.json
**/*secret*
**/*credential*
# the secret scanner itself must be tracked — its name matches the pattern above
!scripts/check-secrets.sh

# dependencies and build output
node_modules/
dist/
build/
.turbo/
coverage/
*.log

# osrm graphs — large, regenerated
*.osrm*

# Capacitor / Android local output (P7) — never commit APKs or Gradle caches
apps/mobile/www/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/captures/
*.apk
*.aab
*.apks

# local
.DS_Store
.vscode/
.idea/
