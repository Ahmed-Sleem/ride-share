# secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
**/google-services.json
**/play-service-account*.json
**/*secret*
**/*credential*
# the secret scanner itself must be tracked — its name matches the pattern above
!scripts/check-secrets.sh

# dependencies and build output
node_modules/
dist/
build/
.turbo/
coverage/
*.log

# osrm graphs — large, regenerated
*.osrm*

# Capacitor / Android local output (P7) — never commit APKs or Gradle caches
apps/mobile/www/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/captures/
*.apk
# The one installer that ships with the site: apps/web/server.js serves
# apps/web/downloads/android.apk, and the owner's rule for this project is that the built
# installer lives in the repo, because the app updates its GUI over the air and a new binary is
# a rare event. Everything else stays ignored — a stray APK in a scratch directory must not
# become a commit.
!apps/web/downloads/*.apk
*.aab
*.apks

# local
.DS_Store
.vscode/
.idea/

# break-the-guard harness scratch (never product input)
*.bak
*.orig
*.rej
*~

# python by-products (the release-signing patch is a .py a test executes)
__pycache__/
*.pyc
