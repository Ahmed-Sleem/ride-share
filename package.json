{
  "name": "ride-share",
  "version": "0.1.0",

  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "bash scripts/verify-repo.sh && pnpm -r --if-present build && pnpm -r --if-present typecheck && pnpm -r --if-present lint && pnpm -r --if-present test",
    "verify:full": "bash scripts/verify-repo.sh && pnpm -r --if-present verify",
    "verify:repo": "bash scripts/verify-repo.sh",
    "migrate": "node-pg-migrate -m infra/migrations --migration-file-language sql",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:verify": "bash scripts/verify-db.sh",
    "build": "pnpm --filter @ride-share/mobile build",
    "start": "node apps/mobile/server.js"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "node-pg-migrate": "catalog:",
    "pg": "catalog:"
  }
}
